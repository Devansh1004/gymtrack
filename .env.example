# Copy to .env for local runs (or set these in the Render dashboard).
PORT=3000

# Push notification keys. Generate once with:  npm run vapid
VAPID_PUBLIC=
VAPID_PRIVATE=
# VAPID_SUBJECT=mailto:you@example.com

# Backup to a PRIVATE GitHub repo (needed on Render free: its disk is wiped on every restart/deploy)
GITHUB_TOKEN=
GITHUB_REPO=yourname/gym-data
# GITHUB_BRANCH=main
# BACKUP_DIR=gym-data
# BACKUP_EVERY_MIN=5

# Optional: only people with this code can sign up. MAX_USERS caps accounts (default 6).
INVITE_CODE=
# MAX_USERS=6
